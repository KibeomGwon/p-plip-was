<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pplip.domain.trip.attraction.persistence.dao.TagDao">
    <select id="findAll" resultType="Tag">
        select * from tag
        limit #{pageSize} offset #{offset};
    </select>

    <select id="findAllByAttractionNo" resultType="Tag">
        select t.id as id,
               t.name as name,
               t.created_at as createdAt
        from tag t
        join attraction_tag at on at.tag_id = t.id
        where at.attraction_id = #{no};
    </select>
</mapper>