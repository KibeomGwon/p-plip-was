<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pplip.domain.trip.attraction.persistence.dao.AttractionDao">
    <select id="findByNo" resultType="AttractionResponse.Details">
        select *
        from attractions
        where no = #{no};
    </select>
</mapper>